{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Закрытый каталог тестовых клиентов — простой формат",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clients"
  ],
  "properties": {
    "clients": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "products",
          "available"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "login": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "products": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          },
          "available": {
            "type": "boolean"
          },
          "access_note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "other_passwords": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          },
          "no_products": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "no_products"
              ],
              "properties": {
                "no_products": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "products": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
